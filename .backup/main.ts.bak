import { createIcons, icons } from "lucide";
import {
  PDFDocument,
  StandardFonts,
  rgb,
  type PDFPage,
} from "pdf-lib";
import * as pdfjs from "pdfjs-dist";
import pdfWorker from "pdfjs-dist/build/pdf.worker.min.mjs?url";
import "./styles.css";

pdfjs.GlobalWorkerOptions.workerSrc = pdfWorker;

type Tool = "select" | "text" | "cover" | "replace";
type ImageExportFormat = "png" | "jpg";
type WordExportMode = "layout" | "text";
type ConversionTool = "pdf" | "merge-pdf" | "pdf-word" | "pdf-images";

type OverlayBase = {
  id: string;
  x: number;
  y: number;
};

type TextOverlay = OverlayBase & {
  type: "text";
  text: string;
  size: number;
  color: string;
};

type CoverOverlay = OverlayBase & {
  type: "cover";
  width: number;
  height: number;
  color: string;
};

type Overlay = TextOverlay | CoverOverlay;

type PdfTextItem = {
  id: string;
  text: string;
  x: number;
  y: number;
  width: number;
  height: number;
  fontSize: number;
};

type SourcePdf = {
  id: string;
  fileName: string;
  bytes: ArrayBuffer;
  pdfDoc: pdfjs.PDFDocumentProxy;
};

type PageItem = {
  id: string;
  sourceId: string;
  sourceName: string;
  pageIndex: number;
  width: number;
  height: number;
  overlays: Overlay[];
};

const root = document.querySelector<HTMLDivElement>("#app");

if (!root) {
  throw new Error("Không tìm thấy root app.");
}

const app = root;

const state = {
  sources: new Map<string, SourcePdf>(),
  pages: [] as PageItem[],
  selectedPageId: "",
  selectedPageIds: new Set<string>(),
  selectionAnchorPageId: "",
  pageListScrollTop: 0,
  selectedOverlayId: "",
  selectedTextItemId: "",
  textItemsByPageId: new Map<string, PdfTextItem[]>(),
  tool: "select" as Tool,
  textValue: "Nội dung mới",
  fontSize: 18,
  fontSizeEdited: false,
  color: "#111827",
  coverColor: "#ffffff",
  exportName: "edited.pdf",
  imageExportFormat: "png" as ImageExportFormat,
  imageExportDpi: 150,
  imageExportQuality: 90,
  wordExportMode: "layout" as WordExportMode,
  conversionTool: "pdf" as ConversionTool,
  pageZoom: 1,
  busy: false,
  status: "Nhập tệp để bắt đầu.",
};

const id = () =>
  typeof crypto !== "undefined" && "randomUUID" in crypto
    ? crypto.randomUUID()
    : `${Date.now()}-${Math.random().toString(16).slice(2)}`;

const clamp = (value: number, min: number, max: number) =>
  Math.min(Math.max(value, min), max);

const roundFontSize = (value: number) =>
  Math.round(clamp(value, 6, 96) * 10) / 10;

const formatFontSize = (value: number) =>
  Number.isInteger(value) ? String(value) : value.toFixed(1);

const formatZoom = () => `${Math.round(state.pageZoom * 100)}%`;

const selectedPage = () =>
  state.pages.find((page) => page.id === state.selectedPageId) ?? null;

const selectedPageIdsInOrder = () =>
  state.pages
    .filter((page) => state.selectedPageIds.has(page.id))
    .map((page) => page.id);

const selectedOverlay = () => {
  const page = selectedPage();
  return page?.overlays.find((overlay) => overlay.id === state.selectedOverlayId) ?? null;
};

const selectedTextItem = () => {
  const page = selectedPage();
  return (page ? state.textItemsByPageId.get(page.id) : undefined)?.find(
    (item) => item.id === state.selectedTextItemId,
  ) ?? null;
};

const escapeHtml = (value: string) =>
  value.replace(/[&<>"']/g, (char) => {
    const entities: Record<string, string> = {
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;",
    };
    return entities[char];
  });

const hexToRgb = (hex: string) => {
  const clean = hex.replace("#", "");
  const full =
    clean.length === 3
      ? clean
          .split("")
          .map((part) => part + part)
          .join("")
      : clean;
  const value = Number.parseInt(full, 16);
  return rgb(
    ((value >> 16) & 255) / 255,
    ((value >> 8) & 255) / 255,
    (value & 255) / 255,
  );
};

const getPageLabel = (page: PageItem, index: number) =>
  `${index + 1}. ${page.sourceName} - trang ${page.pageIndex + 1}`;

function conversionToolbarMarkup(pageCount: number) {
  let controls = "";
  const canExport = state.conversionTool === "merge-pdf"
    ? state.sources.size > 0
    : pageCount > 0;

  if (state.conversionTool === "pdf-word") {
    controls = `
      <select id="word-export-mode" class="toolbar-select" aria-label="Kiểu Word" title="Kiểu Word">
        <option value="layout" ${state.wordExportMode === "layout" ? "selected" : ""}>Giữ bố cục</option>
        <option value="text" ${state.wordExportMode === "text" ? "selected" : ""}>Chỉ text</option>
      </select>
    `;
  } else if (state.conversionTool === "pdf-images") {
    controls = `
      <select id="image-format" class="toolbar-select short" aria-label="Định dạng ảnh" title="Định dạng ảnh">
        <option value="png" ${state.imageExportFormat === "png" ? "selected" : ""}>PNG</option>
        <option value="jpg" ${state.imageExportFormat === "jpg" ? "selected" : ""}>JPG</option>
      </select>
      <label class="toolbar-inline-field" title="Độ phân giải ảnh">
        <span>DPI</span>
        <input id="image-dpi" type="number" min="72" max="300" step="1" value="${state.imageExportDpi}" />
      </label>
      ${
        state.imageExportFormat === "jpg"
          ? `<label class="toolbar-inline-field" title="Chất lượng JPG">
              <span>JPG</span>
              <input id="image-quality" type="number" min="40" max="100" step="1" value="${state.imageExportQuality}" />
            </label>`
          : ""
      }
    `;
  }

  return `
    <div class="toolbar-group conversion-group">
      <span class="toolbar-group-label">Chuyển đổi</span>
      <select id="conversion-tool" class="toolbar-select" aria-label="Tác vụ chuyển đổi">
        <option value="pdf" ${state.conversionTool === "pdf" ? "selected" : ""}>Xuất PDF</option>
        <option value="merge-pdf" ${state.conversionTool === "merge-pdf" ? "selected" : ""}>Merge PDF</option>
        <option value="pdf-word" ${state.conversionTool === "pdf-word" ? "selected" : ""}>PDF → Word</option>
        <option value="pdf-images" ${state.conversionTool === "pdf-images" ? "selected" : ""}>PDF → Hình ảnh</option>
      </select>
      ${controls}
      <button id="export-file" class="toolbar-button accent" ${canExport && !state.busy ? "" : "disabled"}>
        <i data-lucide="download"></i>
        Xuất file
      </button>
    </div>
  `;
}

function render() {
  state.pageListScrollTop =
    document.querySelector<HTMLDivElement>("#page-list")?.scrollTop ?? state.pageListScrollTop;
  const page = selectedPage();
  const overlay = selectedOverlay();
  const textItem = selectedTextItem();
  const fileCount = state.sources.size;
  const pageCount = state.pages.length;

  app.innerHTML = `
    <main class="shell">
      <header class="topbar">
        <div>
          <p class="eyebrow">Support PDF</p>
          <h1>Công cụ PDF</h1>
        </div>
      </header>

      <nav class="commandbar" aria-label="Thanh công cụ PDF">
        <div class="commandbar-scroll">
          <div class="toolbar-group">
            <label class="toolbar-button accent" title="Nhập tệp">
              <i data-lucide="file-plus-2"></i>
              Nhập tệp
              <input id="file-input" type="file" multiple />
            </label>
          </div>

          <span class="toolbar-separator"></span>

          <div class="toolbar-group">
            <span class="toolbar-group-label">Chỉnh sửa</span>
            ${toolButton("select", "mouse-pointer-2", "Chọn")}
            ${toolButton("text", "type", "Thêm chữ")}
            ${toolButton("cover", "square", "Che nội dung")}
            ${toolButton("replace", "text-cursor-input", "Sửa text gốc")}
          </div>

          <span class="toolbar-separator"></span>

          ${conversionToolbarMarkup(pageCount)}
        </div>
      </nav>

      <section class="workspace">
        <aside class="sidebar">
          <div class="panel-header">
            <div>
              <h2>Tệp & trang</h2>
              <p>${fileCount} file, ${pageCount} trang</p>
            </div>
            <button class="icon-button small" id="clear-all" title="Làm mới" ${pageCount ? "" : "disabled"}>
              <i data-lucide="rotate-ccw"></i>
            </button>
          </div>

          <div class="page-list" id="page-list">
            ${
              pageCount
                ? state.pages
                    .map(
                      (item, index) => `
                        <button class="page-row ${state.selectedPageIds.has(item.id) ? "selected" : ""} ${item.id === state.selectedPageId ? "active" : ""}" data-page-id="${item.id}">
                          <span class="page-number">${index + 1}</span>
                          <span>
                            <strong>${escapeHtml(item.sourceName)}</strong>
                            <small>Trang gốc ${item.pageIndex + 1} · ${item.overlays.length} lớp sửa</small>
                          </span>
                        </button>
                      `,
                    )
                    .join("")
                : `<div class="empty">
                    <i data-lucide="files"></i>
                    <p>Chưa có tài liệu</p>
                  </div>`
            }
          </div>

          <div class="sidebar-actions">
            <button id="move-up" class="tool-button" ${page ? "" : "disabled"} title="Đưa trang lên">
              <i data-lucide="arrow-up"></i>
            </button>
            <button id="move-down" class="tool-button" ${page ? "" : "disabled"} title="Đưa trang xuống">
              <i data-lucide="arrow-down"></i>
            </button>
            <button id="reverse-pages" class="tool-button" ${pageCount > 1 ? "" : "disabled"} title="Đảo ngược thứ tự tất cả trang">
              <i data-lucide="arrow-down-up"></i>
            </button>
            <button id="delete-page" class="tool-button danger" ${page ? "" : "disabled"} title="Xóa trang">
              <i data-lucide="trash-2"></i>
            </button>
          </div>
        </aside>

        <section class="stage-wrap">
          <div class="drop-zone" id="drop-zone">
            <div class="stage-toolbar">
              <div class="stage-title">
                <i data-lucide="file-text"></i>
                <div>
                  <strong>${page ? escapeHtml(page.sourceName) : "Tài liệu"}</strong>
                  <span>${page ? `Trang ${state.pages.indexOf(page) + 1} / ${pageCount}` : "Chưa có trang"}</span>
                </div>
              </div>
              <div class="stage-controls">
                <button id="zoom-out" class="icon-button small" title="Thu nhỏ trang" ${page ? "" : "disabled"}>
                  <i data-lucide="zoom-out"></i>
                </button>
                <button id="zoom-reset" class="zoom-value" title="Vừa khung" ${page ? "" : "disabled"}>${formatZoom()}</button>
                <button id="zoom-in" class="icon-button small" title="Phóng to trang" ${page ? "" : "disabled"}>
                  <i data-lucide="zoom-in"></i>
                </button>
              </div>
              <p class="status ${state.busy ? "busy" : ""}">${escapeHtml(state.status)}</p>
            </div>

            <div class="document-frame">
              ${
                page
                  ? `<div class="canvas-shell" id="canvas-shell">
                      <canvas id="pdf-canvas"></canvas>
                      <div class="text-hit-layer" id="text-hit-layer">
                        ${
                          state.tool === "replace"
                            ? (state.textItemsByPageId.get(page.id) ?? [])
                                .map((item) => textHitMarkup(item))
                                .join("")
                            : ""
                        }
                      </div>
                      <div class="overlay-layer" id="overlay-layer">
                        ${page.overlays.map((item) => overlayMarkup(item)).join("")}
                      </div>
                    </div>`
                  : `<div class="empty-stage">
                      <i data-lucide="file-up"></i>
                      <h2>Nhập tệp</h2>
                    </div>`
              }
            </div>
          </div>
        </section>

        <aside class="inspector">
          <div class="panel-header">
            <div>
              <h2>Chỉnh sửa</h2>
              <p>${page ? escapeHtml(getPageLabel(page, state.pages.indexOf(page))) : "Chưa chọn trang"}</p>
            </div>
          </div>

          <label class="field">
            <span>Tên file xuất</span>
            <input id="export-name" value="${escapeHtml(state.exportName)}" />
          </label>

          <div class="divider"></div>

          <label class="field">
            <span>Nội dung chữ</span>
            <textarea id="text-value" rows="3">${escapeHtml(state.textValue)}</textarea>
          </label>

          <div class="field-grid">
            <label class="field">
              <span>Cỡ chữ</span>
              <input id="font-size" type="number" min="6" max="96" step="0.1" value="${formatFontSize(state.fontSize)}" />
            </label>
            <label class="field color-field">
              <span>Màu chữ</span>
              <input id="text-color" type="color" value="${state.color}" />
            </label>
          </div>

          <label class="field">
            <span>Màu che</span>
            <input id="cover-color" type="color" value="${state.coverColor}" />
          </label>

          ${
            textItem
              ? `<div class="selected-text-box">
                  <span>Text gốc đang chọn</span>
                  <strong>${escapeHtml(textItem.text.slice(0, 90))}</strong>
                </div>
                <button id="replace-text" class="wide-button accent" ${state.busy ? "disabled" : ""}>
                  <i data-lucide="check"></i>
                  Lưu thay đổi
                </button>`
              : ""
          }

          <div class="divider"></div>

          <div class="overlay-list">
            <div class="section-heading">
              <span>Lớp sửa trên trang</span>
              <small>${page?.overlays.length ?? 0} lớp</small>
            </div>
            ${
              page?.overlays.length
                ? page.overlays
                    .map(
                      (item, index) => `
                        <button class="overlay-row ${item.id === state.selectedOverlayId ? "active" : ""}" data-overlay-id="${item.id}">
                          <i data-lucide="${item.type === "text" ? "type" : "square"}"></i>
                          <span>${index + 1}. ${item.type === "text" ? escapeHtml(item.text.slice(0, 32)) : "Vùng che"}</span>
                        </button>
                      `,
                    )
                    .join("")
                : `<p class="empty-note">Chưa có lớp chỉnh sửa.</p>`
            }
          </div>

          <button id="delete-overlay" class="wide-button danger" ${overlay ? "" : "disabled"}>
            <i data-lucide="trash-2"></i>
            Xóa lớp đang chọn
          </button>
        </aside>
      </section>
    </main>
  `;

  bindEvents();
  createIcons({ icons });
  const pageList = document.querySelector<HTMLDivElement>("#page-list");
  if (pageList) {
    pageList.scrollTop = state.pageListScrollTop;
  }
  void renderSelectedPdfPage();
}

function toolButton(tool: Tool, icon: string, label: string) {
  return `
    <button class="toolbar-tool ${state.tool === tool ? "active" : ""}" data-tool="${tool}" title="${label}">
      <i data-lucide="${icon}"></i>
      <span>${label}</span>
    </button>
  `;
}

function overlayMarkup(overlay: Overlay) {
  const selected = overlay.id === state.selectedOverlayId ? "selected" : "";
  const style =
    overlay.type === "text"
      ? `left:${overlay.x * 100}%;top:${overlay.y * 100}%;font-size:${overlay.size}px;color:${overlay.color};`
      : `left:${overlay.x * 100}%;top:${overlay.y * 100}%;width:${overlay.width * 100}%;height:${overlay.height * 100}%;background:${overlay.color};`;

  return `
    <button class="pdf-overlay ${overlay.type} ${selected}" data-overlay-id="${overlay.id}" style="${style}" title="Chọn lớp sửa">
      ${overlay.type === "text" ? escapeHtml(overlay.text) : ""}
    </button>
  `;
}

function textHitMarkup(item: PdfTextItem) {
  const selected = item.id === state.selectedTextItemId ? "selected" : "";
  return `
    <button class="text-hit ${selected}" data-text-item-id="${item.id}" style="left:${item.x * 100}%;top:${item.y * 100}%;width:${item.width * 100}%;height:${item.height * 100}%;" title="Chọn text gốc">
      ${escapeHtml(item.text)}
    </button>
  `;
}

function bindEvents() {
  document.querySelector<HTMLInputElement>("#file-input")?.addEventListener("change", (event) => {
    const input = event.currentTarget as HTMLInputElement;
    void importFiles(input.files);
    input.value = "";
  });

  document.querySelector<HTMLButtonElement>("#export-file")?.addEventListener("click", () => {
    void exportSelectedFile();
  });

  document.querySelector<HTMLButtonElement>("#zoom-out")?.addEventListener("click", () => {
    setPageZoom(state.pageZoom - 0.1);
  });

  document.querySelector<HTMLButtonElement>("#zoom-reset")?.addEventListener("click", () => {
    setPageZoom(1);
  });

  document.querySelector<HTMLButtonElement>("#zoom-in")?.addEventListener("click", () => {
    setPageZoom(state.pageZoom + 0.1);
  });

  document.querySelector<HTMLButtonElement>("#clear-all")?.addEventListener("click", () => {
    resetSession();
    state.status = "Đã làm mới. Nhập tệp để bắt đầu.";
    render();
  });

  document.querySelectorAll<HTMLButtonElement>("[data-page-id]").forEach((button) => {
    button.addEventListener("click", (event) => {
      selectPage(button.dataset.pageId ?? "", {
        toggle: event.ctrlKey || event.metaKey,
        range: event.shiftKey,
      });
    });
  });

  document.querySelector<HTMLDivElement>("#page-list")?.addEventListener("keydown", (event) => {
    if (event.key === "Delete" || event.key === "0") {
      event.preventDefault();
      deleteSelectedPage();
    }
  });

  document.querySelector<HTMLDivElement>("#page-list")?.addEventListener("scroll", (event) => {
    state.pageListScrollTop = (event.currentTarget as HTMLDivElement).scrollTop;
  });

  document.querySelectorAll<HTMLButtonElement>("[data-tool]").forEach((button) => {
    button.addEventListener("click", () => {
      state.tool = (button.dataset.tool as Tool) ?? "select";
      state.status =
        state.tool === "text"
          ? "Bấm lên trang để thêm chữ."
          : state.tool === "cover"
            ? "Kéo trên trang để tạo vùng che."
            : state.tool === "replace"
              ? "Bấm vào text trên trang để chọn text gốc."
              : "Chọn lớp sửa để xóa hoặc tiếp tục xem trang.";
      render();
    });
  });

  document.querySelector<HTMLInputElement>("#export-name")?.addEventListener("input", (event) => {
    const input = event.currentTarget as HTMLInputElement;
    state.exportName = input.value.trim() || "edited.pdf";
  });

  document.querySelector<HTMLTextAreaElement>("#text-value")?.addEventListener("input", (event) => {
    const input = event.currentTarget as HTMLTextAreaElement;
    state.textValue = input.value;
  });

  document.querySelector<HTMLInputElement>("#font-size")?.addEventListener("input", (event) => {
    const input = event.currentTarget as HTMLInputElement;
    state.fontSize = roundFontSize(Number(input.value) || 18);
    state.fontSizeEdited = true;
  });

  document.querySelector<HTMLInputElement>("#text-color")?.addEventListener("input", (event) => {
    const input = event.currentTarget as HTMLInputElement;
    state.color = input.value;
  });

  document.querySelector<HTMLInputElement>("#cover-color")?.addEventListener("input", (event) => {
    const input = event.currentTarget as HTMLInputElement;
    state.coverColor = input.value;
  });

  document.querySelector<HTMLSelectElement>("#image-format")?.addEventListener("change", (event) => {
    const select = event.currentTarget as HTMLSelectElement;
    state.imageExportFormat = select.value === "jpg" ? "jpg" : "png";
    render();
  });

  document.querySelector<HTMLInputElement>("#image-dpi")?.addEventListener("input", (event) => {
    const input = event.currentTarget as HTMLInputElement;
    state.imageExportDpi = Math.round(clamp(Number(input.value) || 150, 72, 300));
  });

  document.querySelector<HTMLInputElement>("#image-quality")?.addEventListener("input", (event) => {
    const input = event.currentTarget as HTMLInputElement;
    state.imageExportQuality = Math.round(clamp(Number(input.value) || 90, 40, 100));
  });

  document.querySelector<HTMLSelectElement>("#word-export-mode")?.addEventListener("change", (event) => {
    const select = event.currentTarget as HTMLSelectElement;
    state.wordExportMode = select.value === "text" ? "text" : "layout";
  });

  document.querySelector<HTMLSelectElement>("#conversion-tool")?.addEventListener("change", (event) => {
    const select = event.currentTarget as HTMLSelectElement;
    const value = select.value as ConversionTool;
    state.conversionTool = ["pdf", "merge-pdf", "pdf-word", "pdf-images"].includes(value)
      ? value
      : "pdf";
    render();
  });

  document.querySelector<HTMLButtonElement>("#delete-page")?.addEventListener("click", () => {
    deleteSelectedPage();
  });

  document.querySelector<HTMLButtonElement>("#move-up")?.addEventListener("click", () => {
    moveSelectedPage(-1);
  });

  document.querySelector<HTMLButtonElement>("#move-down")?.addEventListener("click", () => {
    moveSelectedPage(1);
  });

  document.querySelector<HTMLButtonElement>("#reverse-pages")?.addEventListener("click", () => {
    reverseAllPages();
  });

  document.querySelectorAll<HTMLButtonElement>("[data-overlay-id]").forEach((button) => {
    button.addEventListener("click", (event) => {
      event.stopPropagation();
      state.selectedOverlayId = button.dataset.overlayId ?? "";
      state.tool = "select";
      state.status = "Đã chọn lớp sửa.";
      render();
    });
  });

  document.querySelector<HTMLButtonElement>("#delete-overlay")?.addEventListener("click", () => {
    deleteSelectedOverlay();
  });

  document.querySelector<HTMLButtonElement>("#replace-text")?.addEventListener("click", () => {
    void replaceSelectedText();
  });

  bindTextHitEvents();

  const dropZone = document.querySelector<HTMLDivElement>("#drop-zone");
  dropZone?.addEventListener("dragover", (event) => {
    event.preventDefault();
    dropZone.classList.add("dragging");
  });
  dropZone?.addEventListener("dragleave", () => {
    dropZone.classList.remove("dragging");
  });
  dropZone?.addEventListener("drop", (event) => {
    event.preventDefault();
    dropZone.classList.remove("dragging");
    void importFiles(event.dataTransfer?.files ?? null);
  });

  bindCanvasInteractions();
}

function isTextEditingTarget(target: EventTarget | null) {
  if (!(target instanceof HTMLElement)) {
    return false;
  }

  return target.isContentEditable
    || target instanceof HTMLInputElement
    || target instanceof HTMLTextAreaElement
    || target instanceof HTMLSelectElement;
}

function bindGlobalKeyboardShortcuts() {
  document.addEventListener("keydown", (event) => {
    if (
      !state.pages.length
      || isTextEditingTarget(event.target)
      || (event.key !== "ArrowUp" && event.key !== "ArrowDown")
    ) {
      return;
    }

    event.preventDefault();
    movePageFocus(event.key === "ArrowUp" ? -1 : 1, event.shiftKey);
  });
}

function bindTextHitEvents() {
  document.querySelectorAll<HTMLButtonElement>("[data-text-item-id]").forEach((button) => {
    button.addEventListener("pointerdown", (event) => {
      event.stopPropagation();
    });
    button.addEventListener("click", (event) => {
      event.stopPropagation();
      const item = (state.textItemsByPageId.get(selectedPage()?.id ?? "") ?? []).find(
        (candidate) => candidate.id === button.dataset.textItemId,
      );
      if (!item) {
        return;
      }
      state.selectedTextItemId = item.id;
      state.selectedOverlayId = "";
      state.textValue = item.text;
      state.fontSize = roundFontSize(item.fontSize);
      state.fontSizeEdited = false;
      state.tool = "replace";
      state.status = "Đã chọn text gốc. Sửa nội dung rồi bấm lưu.";
      render();
    });
  });
}

function bindCanvasInteractions() {
  const shell = document.querySelector<HTMLDivElement>("#canvas-shell");
  if (!shell) {
    return;
  }

  let dragStart: { x: number; y: number } | null = null;
  let preview: HTMLDivElement | null = null;

  shell.addEventListener("pointerdown", (event) => {
    const page = selectedPage();
    if (!page) {
      return;
    }

    if (state.tool === "replace") {
      return;
    }

    const point = getNormalizedPoint(event, shell);

    if (state.tool === "text") {
      page.overlays.push({
        id: id(),
        type: "text",
        text: state.textValue || "Nội dung mới",
        size: state.fontSize,
        color: state.color,
        x: point.x,
        y: point.y,
      });
      state.status = "Đã thêm chữ vào trang.";
      render();
      return;
    }

    if (state.tool === "cover") {
      shell.setPointerCapture(event.pointerId);
      dragStart = point;
      preview = document.createElement("div");
      preview.className = "drag-preview";
      preview.style.background = state.coverColor;
      shell.append(preview);
      updateDragPreview(preview, dragStart, point);
    }
  });

  shell.addEventListener("pointermove", (event) => {
    if (!dragStart || !preview) {
      return;
    }
    updateDragPreview(preview, dragStart, getNormalizedPoint(event, shell));
  });

  shell.addEventListener("pointerup", (event) => {
    const page = selectedPage();
    if (!page || !dragStart) {
      return;
    }

    const end = getNormalizedPoint(event, shell);
    const rect = normalizedRect(dragStart, end);
    preview?.remove();
    preview = null;
    dragStart = null;

    if (rect.width < 0.01 || rect.height < 0.01) {
      return;
    }

    page.overlays.push({
      id: id(),
      type: "cover",
      color: state.coverColor,
      ...rect,
    });
    state.status = "Đã thêm vùng che nội dung.";
    render();
  });
}

function getNormalizedPoint(event: PointerEvent, element: HTMLElement) {
  const bounds = element.getBoundingClientRect();
  return {
    x: clamp((event.clientX - bounds.left) / bounds.width, 0, 1),
    y: clamp((event.clientY - bounds.top) / bounds.height, 0, 1),
  };
}

function normalizedRect(start: { x: number; y: number }, end: { x: number; y: number }) {
  const x = Math.min(start.x, end.x);
  const y = Math.min(start.y, end.y);
  return {
    x,
    y,
    width: Math.abs(end.x - start.x),
    height: Math.abs(end.y - start.y),
  };
}

function updateDragPreview(
  preview: HTMLDivElement,
  start: { x: number; y: number },
  end: { x: number; y: number },
) {
  const rect = normalizedRect(start, end);
  preview.style.left = `${rect.x * 100}%`;
  preview.style.top = `${rect.y * 100}%`;
  preview.style.width = `${rect.width * 100}%`;
  preview.style.height = `${rect.height * 100}%`;
}

function isPdfFile(file: File) {
  return file.type === "application/pdf" || file.name.toLowerCase().endsWith(".pdf");
}

function isWordFile(file: File) {
  return /\.(docx?|rtf|odt)$/i.test(file.name);
}

function isImageFile(file: File) {
  return file.type === "image/png"
    || file.type === "image/jpeg"
    || /\.(png|jpe?g)$/i.test(file.name);
}

function convertedWordFileName(fileName: string) {
  const baseName = fileName.replace(/\.(docx?|rtf|odt)$/i, "") || "word-file";
  return `${baseName}.pdf`;
}

function convertedImageFileName(fileName: string) {
  const baseName = fileName.replace(/\.(png|jpe?g)$/i, "") || "image-file";
  return `${baseName}.pdf`;
}

async function imageToPdf(file: File) {
  const outputDoc = await PDFDocument.create();
  const bytes = await file.arrayBuffer();
  const isPng = file.type === "image/png" || file.name.toLowerCase().endsWith(".png");
  const image = isPng
    ? await outputDoc.embedPng(bytes)
    : await outputDoc.embedJpg(bytes);
  const maxPageDimension = 14_400;
  const pageScale = Math.min(1, maxPageDimension / Math.max(image.width, image.height));
  const width = image.width * pageScale;
  const height = image.height * pageScale;
  const page = outputDoc.addPage([width, height]);

  page.drawImage(image, { x: 0, y: 0, width, height });
  return uint8ArrayToArrayBuffer(await outputDoc.save());
}

async function requestWordToPdf(file: File) {
  const response = await fetch("/api/word-to-pdf", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      fileBase64: arrayBufferToBase64(await file.arrayBuffer()),
      fileName: file.name,
    }),
  });

  if (!response.ok) {
    const errorPayload = await response.json().catch(() => null) as { error?: string } | null;
    throw new Error(errorPayload?.error || "Không thể chuyển Word sang PDF.");
  }

  return response.arrayBuffer();
}

function resetSession() {
  for (const source of state.sources.values()) {
    void source.pdfDoc.destroy();
  }

  state.sources.clear();
  state.pages = [];
  state.selectedPageId = "";
  state.selectedPageIds.clear();
  state.selectionAnchorPageId = "";
  state.pageListScrollTop = 0;
  state.selectedOverlayId = "";
  state.selectedTextItemId = "";
  state.textItemsByPageId.clear();
  state.pageZoom = 1;
}

function getPageIndex(pageId: string) {
  return state.pages.findIndex((page) => page.id === pageId);
}

function focusPageRow(pageId: string) {
  if (!pageId) {
    return;
  }

  requestAnimationFrame(() => {
    document.querySelector<HTMLButtonElement>(`[data-page-id="${pageId}"]`)?.focus();
  });
}

function setPageZoom(value: number) {
  state.pageZoom = Math.round(clamp(value, 0.5, 2.5) * 10) / 10;
  state.status = state.pageZoom === 1
    ? "Đã đưa trang vừa khung."
    : `Đã zoom trang ${formatZoom()}.`;
  render();
}

function selectOnlyPage(pageId: string) {
  state.selectedPageId = pageId;
  state.selectedPageIds = pageId ? new Set([pageId]) : new Set();
  state.selectionAnchorPageId = pageId;
}

function selectPageRange(fromPageId: string, toPageId: string, append = false) {
  const fromIndex = getPageIndex(fromPageId);
  const toIndex = getPageIndex(toPageId);

  if (fromIndex === -1 || toIndex === -1) {
    selectOnlyPage(toPageId);
    return;
  }

  const [start, end] = fromIndex < toIndex
    ? [fromIndex, toIndex]
    : [toIndex, fromIndex];
  const nextSelectedPageIds = append
    ? new Set(state.selectedPageIds)
    : new Set<string>();

  for (let index = start; index <= end; index += 1) {
    nextSelectedPageIds.add(state.pages[index].id);
  }

  state.selectedPageId = toPageId;
  state.selectedPageIds = nextSelectedPageIds;
}

function selectPage(pageId: string, options: { toggle?: boolean; range?: boolean } = {}) {
  if (!pageId) {
    return;
  }

  if (options.range) {
    const anchorPageId = state.selectionAnchorPageId || state.selectedPageId || pageId;
    selectPageRange(anchorPageId, pageId, options.toggle);
  } else if (options.toggle) {
    const nextSelectedPageIds = new Set(state.selectedPageIds);

    if (nextSelectedPageIds.has(pageId) && nextSelectedPageIds.size > 1) {
      nextSelectedPageIds.delete(pageId);
      state.selectedPageIds = nextSelectedPageIds;
      state.selectedPageId = selectedPageIdsInOrder().at(-1) ?? "";
    } else {
      nextSelectedPageIds.add(pageId);
      state.selectedPageIds = nextSelectedPageIds;
      state.selectedPageId = pageId;
    }

    state.selectionAnchorPageId = pageId;
  } else {
    selectOnlyPage(pageId);
  }

  state.selectedOverlayId = "";
  state.selectedTextItemId = "";
  state.status = state.selectedPageIds.size > 1
    ? `Đã chọn ${state.selectedPageIds.size} trang.`
    : "Đã chọn trang.";
  render();
  focusPageRow(state.selectedPageId);
}

function movePageFocus(direction: -1 | 1, extendSelection: boolean) {
  const currentIndex = getPageIndex(state.selectedPageId);
  const targetIndex = clamp(currentIndex === -1 ? 0 : currentIndex + direction, 0, state.pages.length - 1);
  const targetPageId = state.pages[targetIndex]?.id ?? "";

  if (!targetPageId || targetPageId === state.selectedPageId) {
    return;
  }

  if (extendSelection) {
    const anchorPageId = state.selectionAnchorPageId || state.selectedPageId || targetPageId;
    selectPageRange(anchorPageId, targetPageId);
    state.selectedOverlayId = "";
    state.selectedTextItemId = "";
    state.status = `Đã chọn ${state.selectedPageIds.size} trang.`;
    render();
    focusPageRow(targetPageId);
    return;
  }

  selectOnlyPage(targetPageId);
  state.selectedOverlayId = "";
  state.selectedTextItemId = "";
  state.status = "Đã chuyển trang.";
  render();
  focusPageRow(targetPageId);
}

async function addPdfSource(bytes: ArrayBuffer, fileName: string) {
  const pdfDoc = await pdfjs.getDocument({ data: bytes.slice(0) }).promise;
  const sourceId = id();

  state.sources.set(sourceId, {
    id: sourceId,
    fileName,
    bytes,
    pdfDoc,
  });

  for (let index = 0; index < pdfDoc.numPages; index += 1) {
    const pdfPage = await pdfDoc.getPage(index + 1);
    const viewport = pdfPage.getViewport({ scale: 1 });

    state.pages.push({
      id: id(),
      sourceId,
      sourceName: fileName,
      pageIndex: index,
      width: viewport.width,
      height: viewport.height,
      overlays: [],
    });
  }
}

async function importFiles(fileList: FileList | null) {
  const selectedFiles = [...(fileList ?? [])];
  const files = selectedFiles.filter(
    (file) => isPdfFile(file) || isWordFile(file) || isImageFile(file),
  );
  const unsupportedCount = selectedFiles.length - files.length;

  if (!files.length) {
    state.status = "Chỉ hỗ trợ PDF, Word, PNG hoặc JPG.";
    render();
    return;
  }

  resetSession();
  state.busy = true;
  state.status = "Đang nhập tài liệu...";
  render();

  try {
    let convertedWordCount = 0;
    let convertedImageCount = 0;
    let firstOutputName = "";

    for (const file of files) {
      let bytes: ArrayBuffer;
      let outputName = file.name;

      if (isWordFile(file)) {
        state.status = `Đang chuyển ${file.name} sang PDF...`;
        bytes = await requestWordToPdf(file);
        outputName = convertedWordFileName(file.name);
        convertedWordCount += 1;
      } else if (isImageFile(file)) {
        state.status = `Đang chuẩn hóa ${file.name} thành PDF...`;
        bytes = await imageToPdf(file);
        outputName = convertedImageFileName(file.name);
        convertedImageCount += 1;
      } else {
        bytes = await file.arrayBuffer();
      }

      firstOutputName ||= outputName;
      await addPdfSource(bytes, outputName);
    }

    selectOnlyPage(state.pages[0]?.id ?? "");
    state.exportName = suggestExportName(firstOutputName || state.exportName);
    const convertedDetails = [
      convertedWordCount ? `${convertedWordCount} tệp Word` : "",
      convertedImageCount ? `${convertedImageCount} ảnh` : "",
    ].filter(Boolean).join(" và ");
    const ignoredDetails = unsupportedCount
      ? ` Đã bỏ qua ${unsupportedCount} tệp chưa được hỗ trợ.`
      : "";
    state.status = `Đã nhập ${files.length} tệp${convertedDetails ? `; đã chuyển ${convertedDetails} sang PDF` : ""}.${ignoredDetails}`;
  } catch (error) {
    state.status = error instanceof Error ? error.message : "Không thể nhập tài liệu.";
  } finally {
    state.busy = false;
    render();
  }
}

function suggestExportName(name: string) {
  const base = name.replace(/\.pdf$/i, "");
  return `${base || "edited"}-edited.pdf`;
}

async function renderSelectedPdfPage() {
  const page = selectedPage();
  const canvas = document.querySelector<HTMLCanvasElement>("#pdf-canvas");
  const shell = document.querySelector<HTMLDivElement>("#canvas-shell");
  const frame = document.querySelector<HTMLDivElement>(".document-frame");
  const source = page ? state.sources.get(page.sourceId) : null;

  if (!page || !canvas || !shell || !frame || !source) {
    return;
  }

  const pdfPage = await source.pdfDoc.getPage(page.pageIndex + 1);
  const baseViewport = pdfPage.getViewport({ scale: 1 });
  const frameStyle = getComputedStyle(frame);
  const horizontalPadding =
    Number.parseFloat(frameStyle.paddingLeft) + Number.parseFloat(frameStyle.paddingRight);
  const verticalPadding =
    Number.parseFloat(frameStyle.paddingTop) + Number.parseFloat(frameStyle.paddingBottom);
  const availableWidth = Math.max(frame.clientWidth - horizontalPadding - 8, 120);
  const availableHeight = Math.max(frame.clientHeight - verticalPadding - 8, 120);
  const fitScale = Math.min(availableWidth / baseViewport.width, availableHeight / baseViewport.height);
  const scale = fitScale * state.pageZoom;
  const viewport = pdfPage.getViewport({ scale });
  const pixelRatio = window.devicePixelRatio || 1;
  const context = canvas.getContext("2d");

  if (!context) {
    return;
  }

  canvas.width = Math.floor(viewport.width * pixelRatio);
  canvas.height = Math.floor(viewport.height * pixelRatio);
  canvas.style.width = `${viewport.width}px`;
  canvas.style.height = `${viewport.height}px`;
  shell.style.width = `${viewport.width}px`;
  shell.style.height = `${viewport.height}px`;

  context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
  context.clearRect(0, 0, viewport.width, viewport.height);
  await pdfPage.render({ canvasContext: context, viewport }).promise;

  const textContent = await pdfPage.getTextContent();
  const textItems: PdfTextItem[] = [];

  for (const rawItem of textContent.items) {
    if (!("str" in rawItem) || !rawItem.str.trim()) {
      continue;
    }

    const item = rawItem as {
      str: string;
      transform: number[];
      width: number;
      height: number;
    };
    const transform = pdfjs.Util.transform(viewport.transform, item.transform);
    const fontHeight = Math.max(Math.hypot(transform[2], transform[3]), item.height * scale);
    const left = clamp(transform[4], 0, viewport.width);
    const top = clamp(transform[5] - fontHeight, 0, viewport.height);
    const width = clamp(item.width * scale, 8, viewport.width - left);
    const height = clamp(fontHeight, 10, viewport.height - top);

    if (width <= 0 || height <= 0) {
      continue;
    }

    textItems.push({
      id: `${page.id}-text-${textItems.length}`,
      text: item.str,
      x: left / viewport.width,
      y: top / viewport.height,
      width: width / viewport.width,
      height: height / viewport.height,
      fontSize: clamp(fontHeight / scale, 6, 144),
    });
  }

  state.textItemsByPageId.set(page.id, textItems);
  const hitLayer = document.querySelector<HTMLDivElement>("#text-hit-layer");
  if (hitLayer) {
    hitLayer.innerHTML = state.tool === "replace" ? textItems.map(textHitMarkup).join("") : "";
    bindTextHitEvents();
  }
}

function deleteSelectedPage() {
  const selectedIds = selectedPageIdsInOrder();
  if (!selectedIds.length) {
    return;
  }

  const selectedIdSet = new Set(selectedIds);
  const firstSelectedIndex = state.pages.findIndex((page) => selectedIdSet.has(page.id));
  state.pages = state.pages.filter((page) => !selectedIdSet.has(page.id));

  for (const pageId of selectedIds) {
    state.textItemsByPageId.delete(pageId);
  }

  const nextPageId = state.pages[Math.min(firstSelectedIndex, state.pages.length - 1)]?.id ?? "";
  selectOnlyPage(nextPageId);
  state.selectedOverlayId = "";
  state.selectedTextItemId = "";
  state.status = "Đã xóa trang khỏi file xuất.";
  render();
  focusPageRow(nextPageId);
}

function moveSelectedPage(direction: -1 | 1) {
  const selectedIds = selectedPageIdsInOrder();
  if (!selectedIds.length) {
    return;
  }

  const selectedIdSet = new Set(selectedIds);
  const selectedIndexes = state.pages
    .map((page, index) => selectedIdSet.has(page.id) ? index : -1)
    .filter((index) => index !== -1);
  const firstIndex = selectedIndexes[0];
  const lastIndex = selectedIndexes[selectedIndexes.length - 1];

  if (
    (direction === -1 && firstIndex === 0)
    || (direction === 1 && lastIndex === state.pages.length - 1)
  ) {
    return;
  }

  if (direction === -1) {
    for (const index of selectedIndexes) {
      const [page] = state.pages.splice(index, 1);
      state.pages.splice(index - 1, 0, page);
    }
  } else {
    for (const index of [...selectedIndexes].reverse()) {
      const [page] = state.pages.splice(index, 1);
      state.pages.splice(index + 1, 0, page);
    }
  }

  state.selectedPageIds = new Set(selectedIds);
  state.status = "Đã đổi thứ tự trang.";
  render();
}

function reverseAllPages() {
  if (state.pages.length < 2) {
    return;
  }

  state.pages.reverse();
  state.status = "Đã đảo ngược thứ tự tất cả trang.";
  render();
  focusPageRow(state.selectedPageId);
}

function deleteSelectedOverlay() {
  const page = selectedPage();
  if (!page) {
    return;
  }

  page.overlays = page.overlays.filter((overlay) => overlay.id !== state.selectedOverlayId);
  state.selectedOverlayId = "";
  state.status = "Đã xóa lớp sửa.";
  render();
}

async function replaceSelectedText() {
  const page = selectedPage();
  const source = page ? state.sources.get(page.sourceId) : null;
  const textItem = selectedTextItem();

  if (!page || !source || !textItem) {
    state.status = "Hãy chọn một text gốc trên trang trước.";
    render();
    return;
  }

  if (!state.textValue.trim()) {
    state.status = "Text thay thế không được để trống.";
    render();
    return;
  }

  state.busy = true;
  state.status = "MuPDF đang thay text gốc...";
  render();

  try {
    const response = await fetch("/api/edit-text", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        pdfBase64: arrayBufferToBase64(source.bytes),
        pageIndex: page.pageIndex,
        rect: [textItem.x, textItem.y, textItem.x + textItem.width, textItem.y + textItem.height],
        originalText: textItem.text,
        text: state.textValue,
        fontSize: state.fontSizeEdited ? state.fontSize : undefined,
        autoFontSize: !state.fontSizeEdited,
        color: state.color,
        coverColor: state.coverColor,
      }),
    });

    if (!response.ok) {
      const errorPayload = await response.json().catch(() => null) as { error?: string } | null;
      throw new Error(errorPayload?.error || "Không thể sửa text PDF.");
    }

    const outputBytes = await response.arrayBuffer();
    await source.pdfDoc.destroy();
    source.bytes = outputBytes;
    source.pdfDoc = await pdfjs.getDocument({ data: outputBytes.slice(0) }).promise;
    state.textItemsByPageId.delete(page.id);
    state.selectedTextItemId = "";
    state.status = "Đã sửa text gốc. Chọn Xuất PDF rồi bấm Xuất file để tải bản hoàn chỉnh.";
  } catch (error) {
    state.status = error instanceof Error ? error.message : "Không thể sửa text PDF.";
  } finally {
    state.busy = false;
    render();
  }
}

function arrayBufferToBase64(buffer: ArrayBuffer) {
  const bytes = new Uint8Array(buffer);
  const chunkSize = 0x8000;
  let binary = "";

  for (let index = 0; index < bytes.length; index += chunkSize) {
    binary += String.fromCharCode(...bytes.subarray(index, index + chunkSize));
  }

  return btoa(binary);
}

function uint8ArrayToArrayBuffer(bytes: Uint8Array) {
  return bytes.buffer.slice(
    bytes.byteOffset,
    bytes.byteOffset + bytes.byteLength,
  ) as ArrayBuffer;
}

async function exportSelectedFile() {
  switch (state.conversionTool) {
    case "merge-pdf":
      await mergeAllPdfs();
      break;
    case "pdf-word":
      await exportPdfToWord();
      break;
    case "pdf-images":
      await exportPdfToImages();
      break;
    default:
      await exportPdf();
  }
}

async function exportPdf() {
  if (!state.pages.length) {
    return;
  }

  state.busy = true;
  state.status = "Đang xuất PDF...";
  render();

  try {
    const outputBytes = await createEditedPdfBytes();
    downloadPdf(outputBytes, state.exportName);
    state.status = "Đã xuất PDF.";
  } catch (error) {
    state.status = error instanceof Error ? error.message : "Không thể xuất PDF.";
  } finally {
    state.busy = false;
    render();
  }
}

async function createEditedPdfBytes() {
  const outputDoc = await PDFDocument.create();
  const sourceDocs = new Map<string, PDFDocument>();
  const font = await outputDoc.embedFont(StandardFonts.Helvetica);

  for (const pageItem of state.pages) {
    const source = state.sources.get(pageItem.sourceId);
    if (!source) {
      continue;
    }

    let sourceDoc = sourceDocs.get(source.id);
    if (!sourceDoc) {
      sourceDoc = await PDFDocument.load(source.bytes.slice(0));
      sourceDocs.set(source.id, sourceDoc);
    }

    const [copiedPage] = await outputDoc.copyPages(sourceDoc, [pageItem.pageIndex]);
    outputDoc.addPage(copiedPage);
    drawOverlays(copiedPage, pageItem, font);
  }

  return outputDoc.save();
}

async function exportPdfToImages() {
  if (!state.pages.length) {
    return;
  }

  state.busy = true;
  state.status = "Đang chuyển PDF sang hình ảnh...";
  render();

  try {
    const outputBytes = await createEditedPdfBytes();
    const response = await fetch("/api/pdf-to-images", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        pdfBase64: arrayBufferToBase64(uint8ArrayToArrayBuffer(outputBytes)),
        fileName: state.exportName,
        format: state.imageExportFormat,
        dpi: state.imageExportDpi,
        quality: state.imageExportQuality,
        pageRange: "all",
      }),
    });

    if (!response.ok) {
      const errorPayload = await response.json().catch(() => null) as { error?: string } | null;
      throw new Error(errorPayload?.error || "Không thể chuyển PDF sang hình ảnh.");
    }

    const zipBytes = await response.arrayBuffer();
    downloadBlob(
      new Blob([zipBytes], { type: "application/zip" }),
      `${state.exportName.replace(/\.pdf$/i, "") || "pdf-pages"}-images.zip`,
    );
    state.status = "Đã chuyển PDF sang hình ảnh.";
  } catch (error) {
    state.status = error instanceof Error ? error.message : "Không thể chuyển PDF sang hình ảnh.";
  } finally {
    state.busy = false;
    render();
  }
}

async function exportPdfToWord() {
  if (!state.pages.length) {
    return;
  }

  state.busy = true;
  state.status = "Đang chuyển PDF sang Word...";
  render();

  try {
    const outputBytes = await createEditedPdfBytes();
    const response = await fetch("/api/pdf-to-word", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        pdfBase64: arrayBufferToBase64(uint8ArrayToArrayBuffer(outputBytes)),
        fileName: state.exportName,
        pageRange: "all",
        mode: state.wordExportMode,
        dpi: 150,
      }),
    });

    if (!response.ok) {
      const errorPayload = await response.json().catch(() => null) as { error?: string } | null;
      throw new Error(errorPayload?.error || "Không thể chuyển PDF sang Word.");
    }

    const docxBytes = await response.arrayBuffer();
    const baseName = state.exportName.replace(/\.pdf$/i, "") || "converted";
    downloadBlob(
      new Blob([docxBytes], {
        type: "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      }),
      `${baseName}.docx`,
    );
    state.status = "Đã chuyển PDF sang Word.";
  } catch (error) {
    state.status = error instanceof Error ? error.message : "Không thể chuyển PDF sang Word.";
  } finally {
    state.busy = false;
    render();
  }
}

async function mergeAllPdfs() {
  if (!state.pages.length) {
    return;
  }

  state.busy = true;
  state.status = "Đang merge theo thứ tự trang đang hiển thị...";
  render();

  try {
    const outputBytes = await createEditedPdfBytes();
    downloadPdf(outputBytes, "merged-all.pdf");
    state.status = "Đã merge PDF theo thứ tự trang đang hiển thị.";
  } catch (error) {
    state.status = error instanceof Error ? error.message : "Không thể merge PDF.";
  } finally {
    state.busy = false;
    render();
  }
}

function downloadPdf(outputBytes: Uint8Array, fileName: string) {
  const outputBuffer = outputBytes.buffer.slice(
    outputBytes.byteOffset,
    outputBytes.byteOffset + outputBytes.byteLength,
  ) as ArrayBuffer;
  const blob = new Blob([outputBuffer], { type: "application/pdf" });
  downloadBlob(blob, fileName.toLowerCase().endsWith(".pdf") ? fileName : `${fileName}.pdf`);
}

function downloadBlob(blob: Blob, fileName: string) {
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");

  link.href = url;
  link.download = fileName;
  link.click();
  URL.revokeObjectURL(url);
}

function drawOverlays(page: PDFPage, pageItem: PageItem, font: Awaited<ReturnType<PDFDocument["embedFont"]>>) {
  const { width, height } = page.getSize();

  for (const overlay of pageItem.overlays) {
    if (overlay.type === "cover") {
      page.drawRectangle({
        x: overlay.x * width,
        y: height - (overlay.y + overlay.height) * height,
        width: overlay.width * width,
        height: overlay.height * height,
        color: hexToRgb(overlay.color),
      });
      continue;
    }

    page.drawText(overlay.text, {
      x: overlay.x * width,
      y: height - overlay.y * height - overlay.size,
      size: overlay.size,
      font,
      color: hexToRgb(overlay.color),
      lineHeight: overlay.size * 1.2,
      maxWidth: width - overlay.x * width - 24,
    });
  }
}

window.addEventListener("resize", () => {
  void renderSelectedPdfPage();
});

bindGlobalKeyboardShortcuts();
render();
